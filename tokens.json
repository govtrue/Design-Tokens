{
  "$schema-note": "GovTrue design tokens — JSON mirror of tokens.css. Hex values are authoritative; hsl mirrors are exact conversions for shadcn-style hsl(var()) consumers. Components consume the `semantic` layer only.",
  "raw": {
    "navy":           { "hex": "#0B1F3A", "hsl": "214 68% 14%" },
    "navy-2":         { "hex": "#142A4C", "hsl": "216 58% 19%" },
    "warm-white":     { "hex": "#FAFAF7", "hsl": "60 23% 97%" },
    "cream":          { "hex": "#F4F1EA", "hsl": "42 31% 94%" },
    "white":          { "hex": "#FFFFFF", "hsl": "0 0% 100%" },
    "ink":            { "hex": "#1A1A1A", "hsl": "0 0% 10%" },
    "gray":           { "hex": "#6B6B6B", "hsl": "0 0% 42%" },
    "warm-gray":      { "hex": "#E5E1D8", "hsl": "42 20% 87%" },
    "teal":           { "hex": "#1D9E75", "hsl": "161 69% 37%" },
    "teal-deep":      { "hex": "#0F6E56", "hsl": "165 76% 25%" },
    "teal-press":     { "hex": "#0B5743", "hsl": "164 78% 19%" },
    "on-navy":        { "hex": "#FAFAF7", "hsl": "60 23% 97%" },
    "on-navy-muted":  { "hex": "#9AA6BD", "hsl": "219 21% 67%" },
    "on-navy-accent": { "hex": "#3DBE96", "hsl": "161 51% 49%" }
  },
  "semantic": {
    "surface-shell":        { "ref": "navy",       "value": "#0B1F3A", "use": "rail, top bar" },
    "surface-shell-raised": { "ref": "navy-2",     "value": "#142A4C", "use": "active nav, hover, on-navy chips" },
    "surface-workspace":    { "ref": "warm-white", "value": "#FAFAF7", "use": "default app background" },
    "surface-card":         { "ref": "white",      "value": "#FFFFFF", "use": "steps off cream sections" },
    "surface-document-meta":{ "ref": "cream",      "value": "#F4F1EA", "use": "metadata tier — third document surface (cream), below paper (surface-card/white) and the nav/page (surface-workspace/warm-white); Codify public legal-document portal. Aliases the existing raw cream — no new color" },
    "border-hairline":      { "ref": "warm-gray",  "value": "#E5E1D8" },
    "action-primary":       { "ref": "teal-deep",  "value": "#0F6E56" },
    "action-primary-hover": { "ref": "teal",       "value": "#1D9E75" },
    "action-primary-press": { "ref": "teal-press", "value": "#0B5743" },
    "accent":               { "ref": "teal",       "value": "#1D9E75", "use": "active state, links" },
    "accent-citation":         { "ref": "teal",      "value": "#1D9E75", "use": "RESERVED for federated research/citation surfaces (Archive, Codify); not consumed in Platform" },
    "accent-citation-surface": { "ref": "teal 12% on white", "value": "color-mix(accent-citation 12%, surface-card) ~#E4F3EE", "use": "tinted background behind citation/source badges; renders only in Codify/Archive, not Platform" },
    "accent-citation-fg":      { "ref": "teal-deep", "value": "#0F6E56", "use": "AA-legible text/numerals on accent-citation-surface (5.42:1) and white (6.20:1); --accent-citation stays the highlight for borders/icons; renders only in Codify/Archive, not Platform" },
    "accent-citation-hover":   { "ref": "teal-deep", "value": "#0F6E56", "use": "hover/active state of citation elements; renders only in Codify/Archive, not Platform" },
    "text-body":            { "ref": "ink",        "value": "#1A1A1A" },
    "text-muted":           { "ref": "gray",       "value": "#6B6B6B" },
    "on-navy":              { "ref": "on-navy",        "value": "#FAFAF7" },
    "on-navy-muted":        { "ref": "on-navy-muted",  "value": "#9AA6BD" },
    "on-navy-accent":       { "ref": "on-navy-accent", "value": "#3DBE96" }
  },
  "typography": {
    "note": "Legal-document type for the federated citation/document surfaces (Codify public code portal). The SSOT owns which-face-per-role: each scale role bakes in family + size + leading + weight. The reading face (Source Serif 4) is a webfont the consumer SELF-HOSTS as woff2 (Codify Phase 2 PR), NOT a CDN — this contract only names the family + a Georgia fallback. Two weights only (400, 500; no 600/700). Type tokens are not colors — no hsl mirror. Sizes in rem (~16px root; px noted).",
    "families": {
      "serif-reading": "\"Source Serif 4\", Georgia, \"Times New Roman\", serif",
      "sans": "\"Inter\", system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
      "mono": "ui-monospace, \"SF Mono\", \"Cascadia Code\", Menlo, Consolas, monospace"
    },
    "scale": {
      "section-number": { "family": "mono",          "size": "0.9375rem", "px": 15, "leading": "1.25", "weight": "500" },
      "catchline":      { "family": "serif-reading",  "size": "1.6875rem", "px": 27, "leading": "1.3",  "weight": "500" },
      "body":           { "family": "serif-reading",  "size": "1.0625rem", "px": 17, "leading": "1.75", "weight": "400" },
      "subsection":     { "family": "serif-reading",  "enumerator-family": "mono", "size": "1.0625rem", "px": 17, "leading": "1.7", "weight": "400" },
      "metadata-label": { "family": "sans",           "size": "0.8125rem", "px": 13, "leading": "1.4",  "weight": "500" },
      "breadcrumb":     { "family": "sans",           "size": "0.875rem",  "px": 14, "leading": "1.4",  "weight": "400" },
      "toc":            { "family": "sans",           "size": "0.875rem",  "px": 14, "leading": "1.5",  "weight": "400" }
    },
    "weights": "400 regular, 500 medium — two weights only (no 600/700)"
  },
  "spacing": {
    "unit": "4px",
    "scale": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px", "6": "32px", "7": "48px", "8": "64px", "9": "96px", "10": "128px" },
    "section-py": "32px (dense: 24px)",
    "note": "Authenticated pages run tighter than the marketing site's 64–120px."
  },
  "radii": {
    "sm": "6px",
    "button": "10px",
    "card": "14px",
    "panel": "20px",
    "pill": "9999px"
  },
  "shadows": {
    "note": "Warm, tinted from navy rgb(11,31,58); never neutral gray. Cards: no rest shadow, md on hover.",
    "sm": "0 1px 2px rgba(11, 31, 58, 0.06)",
    "md": "0 8px 24px rgba(11, 31, 58, 0.10)",
    "lg": "0 16px 34px rgba(11, 31, 58, 0.12)",
    "xl": "0 22px 48px rgba(11, 31, 58, 0.16)"
  },
  "motion": {
    "duration": { "fast": "140ms", "base": "220ms", "slow": "420ms" },
    "easing": { "out": "cubic-bezier(0.16, 1, 0.3, 1)", "in-out": "cubic-bezier(0.65, 0, 0.35, 1)" }
  },
  "contrast": {
    "note": "WCAG AA verified against the actual surface each foreground sits on.",
    "on-navy on #0B1F3A": "15.80:1 (warm-white)",
    "on-navy-muted on #0B1F3A": "6.74:1",
    "on-navy-muted on #142A4C": "5.84:1",
    "on-navy-accent on #0B1F3A": "7.08:1",
    "on-navy-accent on #142A4C": "6.14:1",
    "chip-on-navy icon vs mixed chip bg #163F53": "4.82:1 (graphical object, AA >= 3:1)",
    "chip-on-light icon vs mixed chip bg #E4F3EE": "5.44:1 (graphical object, AA >= 3:1)",
    "accent-citation (teal) TEXT on accent-citation-surface": "2.96:1 (FAILS AA text — use accent-citation-fg for text)",
    "accent-citation-fg (teal-deep) on accent-citation-surface": "5.42:1 (PASS AA text)",
    "accent-citation-fg (teal-deep) on white": "6.20:1 (PASS AA text)"
  }
}
